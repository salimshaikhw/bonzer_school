# Copy to .env (never commit .env) and fill in the values marked REQUIRED.
#   cp .env.example .env

# ---- REQUIRED ----
POSTGRES_PASSWORD=change-me-postgres
# At least 32 random characters, e.g. from: openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-secret-of-at-least-32-chars
PLATFORM_ADMIN_PASSWORD=Change@123

# ---- App ----
# Development: Swagger, demo tenant and demo logins seeded, OAuth server with dev certificates.
# Production: no demo data unless SEED_DEMO_DATA=true; set OAuth keys to enable the OAuth server.
ASPNETCORE_ENVIRONMENT=Development
SEED_DEMO_DATA=true
APP_VERSION=1.0.0
API_PORT=5102
CORS_ORIGIN=http://localhost:5173
PLATFORM_ADMIN_EMAIL=superadmin@bonzer.local
JWT_ISSUER=BonzerSchool.Api
JWT_AUDIENCE=BonzerSchool.Client

# ---- Database ----
POSTGRES_USER=postgres
# Host port; 5433 avoids a clash with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=5433

# ---- Logging / Datadog ----
# true when the Datadog Agent collects the container output (profile "datadog").
LOG_JSON_CONSOLE=false
# true to send logs straight to Datadog over HTTP instead of using the Agent.
DATADOG_DIRECT=false
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=local

# ---- Optional sign-in / OAuth ----
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
OAUTH_SIGNING_CERTIFICATE=
OAUTH_SIGNING_CERTIFICATE_PASSWORD=
OAUTH_ENCRYPTION_KEY=

# ---- pgAdmin (profile "tools") ----
PGADMIN_EMAIL=admin@bonzer.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ---- SonarQube (profile "sonar") ----
SONAR_PORT=9000
SONAR_DB_PASSWORD=sonar
# Used by tools/sonar/sonar-scan.ps1 / .sh. Create the token in SonarQube: My Account > Security.
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=
