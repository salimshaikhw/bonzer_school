{
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:3000",
            "http://localhost:5173"
        ]
    },





    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Microsoft.EntityFrameworkCore": "Warning",
                "Microsoft.EntityFrameworkCore.Database.Command": "Fatal",
                "Microsoft.EntityFrameworkCore.Update": "Fatal",
                "Microsoft.EntityFrameworkCore.Query": "Fatal",
                "System.Net.Http.HttpClient": "Warning",
                "OpenIddict": "Warning"
            }
        }
    },
    "AppLogging": {
        "ServiceName": "bonzer-school-api",
        "JsonConsole": null,
        "FilePath": "Logs/bonzer-api-.json",
        "RetainedFileCount": 14,
        "SlowRequestThresholdMs": 3000
    },
    "Datadog": {
        "// ApiKey": "Set Datadog:ApiKey in User Secrets / Azure configuration (Datadog__ApiKey), never here. Leave Enabled false when a Datadog Agent collects the logs.",
        "Enabled": false,
        "Site": "datadoghq.com",
        "MinimumLevel": "Information",
        "Tags": []
    },
    "ConnectionStrings": {
        "DefaultConnection": "",
        "PostgresConnection": ""
    },
    "Tenancy": {
        "CatalogDatabase": "bonzer_catalog",
        "TenantDatabasePrefix": "bonzer_school_",
        "TenantHeader": "X-Tenant",
        "MigrateTenantsOnStartup": true
    },
    "PlatformAdmin": {
        "Email": "superadmin@bonzer.local",
        "Password": ""
    },
    "Jwt": {
        "Key": "",
        "Issuer": "",
        "Audience": "",
        "TokenExpiryDurationInMinutes": 160,
        "RefreshTokenExpiryDurationInDays": 7
    },
    "ExternalLogin": {
        "// ClientId": "OAuth client ids of the SPA. A provider is enabled when its ClientId is set.",
        "Google": { "ClientId": "" },
        "Microsoft": { "ClientId": "" }
    },
    "OAuthServer": {
        "// Keys": "SigningCertificate (base64 PFX), SigningCertificatePassword and EncryptionKey (base64, 32 bytes) belong in User Secrets / Azure configuration. Without them the token endpoint is off outside Development.",
        "Enabled": true,
        "AccessTokenLifetimeMinutes": 60
    },
    "EmailSettings": {
        "SmtpServer": "smtp.gmail.com",
        "Port": 587,
        "SenderName": "BonzerSoft School Erp",
        "SenderEmail": "sjjabbarkhan@gmail.com",
        "Username": "sjjabbarkhan@gmail.com",
        "Password": ""
    },



    "DemoUsers": {
        "Password": "",
        "PrincipalEmail": "principal@local",
        "ClassTeacherEmail": "classteacher@local",
        "ParentEmail": "parent@local",
        "StaffEmail": "staff@local"
    }
}

